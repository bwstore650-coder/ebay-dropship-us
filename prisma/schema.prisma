// Schéma de la base de données (Postgres) — V1
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  NONE
  STARTER
  PRO
  BUSINESS
  AGENCY
}

enum Supplier {
  ALIEXPRESS
  CJ
}

enum ListingStatus {
  DRAFT
  ACTIVE
  PAUSED     // retirée automatiquement (rupture, marge sous le seuil)
  ENDED
}

enum OrderStatus {
  PENDING          // vente eBay reçue, pas encore commandée
  ORDERING         // commande fournisseur en cours (verrou contre les doublons)
  ORDERED          // commandée et payée chez le fournisseur
  SHIPPED          // suivi reçu et renvoyé à eBay
  NEEDS_REVIEW     // à vérifier par le vendeur (perte, rupture, article inconnu…)
  FAILED           // le fournisseur a refusé (solde insuffisant, adresse…)
  CANCELLED        // annulée sur eBay, ou traitée à la main par le vendeur
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String?   // null : compte créé avec Google (pas de mot de passe)
  googleId           String?   // identifiant Google (« sub ») ; un seul compte par identifiant (vérifié dans le code)
  createdAt          DateTime  @default(now())
  locale             String    @default("en") // langue des emails
  termsAcceptedAt    DateTime?
  passwordChangedAt  DateTime?  // les sessions ouvertes avant cette date sont refusées
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?  // blocage temporaire après trop d'essais de mot de passe
  lastAttentionEmailAt DateTime? // dernier email « commandes à vérifier »
  afterSalesSyncedAt DateTime?  // dernier relevé des retours et annulations
  resetTokens        PasswordResetToken[]

  plan               Plan      @default(NONE)
  stripeCustomerId   String?   @unique
  stripeSubscriptionId String? @unique
  billingInterval    String?   // "month" | "year" (depuis Stripe)
  trialEndsAt        DateTime?
  currentPeriodEnd   DateTime?

  minMarginPct       Float     @default(30)    // seuil de marge (%)
  defaultMarketplace String    @default("EBAY_US") // EBAY_US, EBAY_CA, EBAY_GB, EBAY_AU
  ebayAccountOpenedAt DateTime?                // pour les limites anti-ban
  autoOrder          Boolean   @default(true)    // commander automatiquement chez le fournisseur à chaque vente

  // Messages automatiques aux acheteurs (désactivés tant que le vendeur ne les active pas)
  msgThanks          Boolean   @default(false)   // remerciement après l'achat
  msgShipped         Boolean   @default(false)   // numéro de suivi à l'expédition
  msgFeedback        Boolean   @default(false)   // demande d'évaluation après la livraison
  feedbackDelayDays  Int       @default(7)       // jours après l'expédition

  // Publicité automatique (Promoted Listings, coût par vente) et repricing
  adsEnabled         Boolean   @default(false)
  adRateMax          Float     @default(5)        // taux publicitaire maximum (%)
  repriceEnabled     Boolean   @default(false)
  repriceUndercutPct Float     @default(1)        // passer sous le concurrent le moins cher de x %

  // Personne responsable dans l'UE (règlement GPSR) : obligatoire pour vendre sur eBay DE, FR, IT, ES, IE
  euRpCompany        String?
  euRpAddress        String?
  euRpCity           String?
  euRpPostalCode     String?
  euRpCountry        String?   // code pays ISO (DE, FR…)
  euRpEmail          String?

  // Affiliation
  referralCode       String?   @unique
  referredById       String?
  referredBy         User?     @relation("Referrals", fields: [referredById], references: [id])
  referrals          User[]    @relation("Referrals")
  commissionsEarned  Commission[] @relation("AffiliateCommissions")
  commissionsFrom    Commission[] @relation("ReferredCommissions")

  ebayAccounts       EbayAccount[]
  supplierAccounts   SupplierAccount[]
  listings           Listing[]
  orders             Order[]
  review             Review?
  snipeRuns          SnipeRun[]
  savedSellers       SavedSeller[]
  afterSales         AfterSale[]
  extensionTokens    ExtensionToken[]
  savedProducts      SavedProduct[]
  externalListings   ExternalListing[]
  aiUsage            AiUsage[]

  @@index([googleId])
  buyerMessages      BuyerMessage[]
  notifySales        Boolean  @default(true) // email à chaque nouvelle vente
  pushSubscriptions  PushSubscription[]
}

model EbayAccount {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label              String?  // nom donné par le client (formule Agence : un compte par boutique gérée)
  ebayUserId         String?
  accessToken        String   // chiffré au repos (voir lib/crypto.ts)
  accessTokenExpires DateTime
  refreshToken       String   // chiffré au repos
  refreshTokenExpires DateTime
  scopes             String?  // autorisations accordées par le vendeur (ex. publicité) ; null = autorisations d'origine
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  listings           Listing[]
  externalListings   ExternalListing[]
  orders             Order[]
  marketSetups       EbayMarketSetup[]

  @@index([userId])
}

/// Réglages eBay obligatoires avant de publier dans un pays : politiques (livraison, paiement, retours) + lieu d'expédition.
model EbayMarketSetup {
  id                  String      @id @default(cuid())
  ebayAccountId       String
  ebayAccount         EbayAccount @relation(fields: [ebayAccountId], references: [id], onDelete: Cascade)
  marketplaceId       String
  fulfillmentPolicyId String
  paymentPolicyId     String
  returnPolicyId      String
  merchantLocationKey String
  shipPostalCode      String?     // adresse du lieu d'expédition (pour le recréer s'il disparaît chez eBay)
  shipCity            String?
  shipState           String?
  adCampaignId        String?     // campagne Promoted Listings créée par l'outil pour ce pays
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@unique([ebayAccountId, marketplaceId])
}

model SupplierAccount {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplier     Supplier
  accessToken  String   // chiffré au repos
  refreshToken String?
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, supplier])
}

model Listing {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           ListingStatus @default(DRAFT)
  ebayAccountId    String?
  ebayAccount      EbayAccount?  @relation(fields: [ebayAccountId], references: [id], onDelete: SetNull)
  marketplace      String        @default("EBAY_US")
  currency         String        @default("USD")
  sku              String        @unique
  ebayOfferId      String?
  ebayListingId    String?
  title            String
  price            Float         // dans la devise de la marketplace
  supplier         Supplier
  supplierProductId String
  supplierVariantId String?
  supplierCost     Float         // coût produit + livraison (devise de la marketplace) au dernier contrôle
  lastCheckedAt    DateTime?
  lastMarginPct    Float?
  quantity         Int           @default(3)   // quantité affichée sur eBay quand l'annonce est active
  pauseReason      String?       // OUT_OF_STOCK, MARGIN, SLOW, SUPPLIER_GONE : pourquoi l'annonce est en pause
  pauseDetail      String?       // ex. prix minimum conseillé pour retrouver la marge
  categoryId       String?
  errorMessage     String?       // dernier refus d'eBay, pour l'afficher au client
  searchKeyword    String?       // recherche eBay du produit (repricing)
  basePrice        Float?        // prix de départ (le repricing ne dépasse jamais 1,5 ×)
  repricedAt       DateTime?
  adRate           Float?        // taux Promoted Listings en cours (%), null = pas de publicité
  adId             String?
  publishedAt      DateTime?
  /// Annonce créée en dehors de Sellvela (sur eBay) puis liée à un produit fournisseur : mises à jour par l'API Trading.
  legacy           Boolean       @default(false)
  /// Annonce à variantes (tailles, couleurs…) : clé du groupe d'articles eBay ; le détail est dans ListingVariant.
  groupKey         String?
  variants         ListingVariant[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  orders           Order[]

  @@index([ebayAccountId, publishedAt])
  @@index([userId, createdAt])
}

model Order {
  id                 String      @id @default(cuid())
  userId             String
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  ebayAccountId      String?
  ebayAccount        EbayAccount? @relation(fields: [ebayAccountId], references: [id], onDelete: SetNull)
  listingId          String?     // première annonce de la commande
  listing            Listing?    @relation(fields: [listingId], references: [id])
  ebayOrderId        String      @unique
  ebayCreatedAt      DateTime?
  buyerUsername      String?     // pseudo eBay de l'acheteur (messages)
  buyerName          String?     // prénom de l'acheteur (messages)
  msgThanksAt        DateTime?   // messages automatiques déjà envoyés
  msgShippedAt       DateTime?
  msgFeedbackAt      DateTime?
  msgFailures        Int         @default(0)
  marketplace        String      @default("EBAY_US")
  currency           String      @default("USD")
  status             OrderStatus @default(PENDING)
  lines              Json        @default("[]") // [{ lineItemId, sku, quantity, listingId, vid, title }]
  saleTotal          Float
  supplierOrderId    String?
  supplierCost       Float?      // coût fournisseur (devise de la commande)
  fees               Float?      // frais eBay estimés
  profit             Float?
  trackingNumber     String?
  carrier            String?
  errorCode          String?     // raison lisible, traduite à l'écran (LOSS, OUT_OF_STOCK…)
  errorMessage       String?     // détail (message du fournisseur ou d'eBay)
  attempts           Int         @default(0)
  orderedAt          DateTime?
  shippedAt          DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([userId, status])
  @@index([status, updatedAt])
}

/// Emails récoltés par les outils gratuits (calculateur, etc.)
model Lead {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   // ex. "profit-calculator"
  refCode   String?  // code affilié présent au moment de l'inscription
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum CommissionStatus {
  PENDING   // en période de garantie (remboursements possibles)
  PAYABLE   // à verser à l'affilié
  PAID
  VOID      // annulée (remboursement, fraude)
}

/// Commission d'affiliation : 30 % de chaque facture payée par un client parrainé, à vie.
model Commission {
  id              String           @id @default(cuid())
  affiliateId     String
  affiliate       User             @relation("AffiliateCommissions", fields: [affiliateId], references: [id], onDelete: Cascade)
  referredUserId  String
  referredUser    User             @relation("ReferredCommissions", fields: [referredUserId], references: [id], onDelete: Cascade)
  stripeInvoiceId String           @unique   // une commission par facture (idempotent)
  amountCents     Int
  currency        String           @default("usd")
  status          CommissionStatus @default(PENDING)
  availableAt     DateTime                    // fin de la période de garantie
  paidAt          DateTime?
  createdAt       DateTime         @default(now())

  @@index([affiliateId, status])
}

// Avis clients : écrits par de vrais utilisateurs connectés, publiés seulement après validation dans /admin/reviews.
enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id         String       @id @default(cuid())
  userId     String       @unique // un avis par compte
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Int          // 1 à 5
  text       String
  authorName String       // nom affiché (choisi par le client)
  authorInfo String?      // ex. « Vendeur eBay, Texas »
  locale     String
  consent    Boolean      // accord pour publication sur le site
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  approvedAt DateTime?

  @@index([status, approvedAt])
}

/// Lien « mot de passe oublié » : seule l'empreinte SHA-256 du jeton est enregistrée ; valable 1 heure, une seule fois.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

/* ---------- Sniper : recherche automatique de produits rentables ---------- */

enum SnipeMode {
  CATALOG   // parcourt le catalogue du fournisseur (entrepôt du pays) et vérifie chaque produit sur eBay
  KEYWORDS  // teste une liste de mots-clés fournie par le vendeur
}

enum SnipeStatus {
  RUNNING
  DONE
  STOPPED
  FAILED
}

enum SnipeCandidateStatus {
  PENDING     // pas encore analysé
  PROFITABLE  // rentable, prêt à mettre en vente
  REJECTED    // écarté (voir reason)
  LISTED      // mis en vente automatiquement
  ERROR       // analyse impossible (panne passagère)
}

model SnipeRun {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode          SnipeMode
  marketplace   String
  target        Int         // nombre de produits rentables à trouver
  minMarginPct  Float
  minProfit     Float?      // « High ticket » : profit minimum par vente (devise du pays)
  priceMin      Float?
  priceMax      Float?
  costMin       Float?      // prix d'achat fournisseur minimum (devise du pays)
  costMax       Float?      // prix d'achat fournisseur maximum
  categories    Json?       // catégories choisies par le vendeur (identifiants, voir PRODUCT_CATEGORIES)
  autoList      Boolean     @default(false)
  ebayAccountId String?
  seeds         Json        // mots-clés (thèmes du catalogue, ou liste à tester)
  cursor        Json?       // progression dans le catalogue
  status        SnipeStatus @default(RUNNING)
  scanned       Int         @default(0)
  found         Int         @default(0)
  scanLimit     Int?        // produits à analyser au maximum (sinon calculé depuis target ; augmenté par « Continuer »)
  listed        Int         @default(0)
  error         String?
  lockedUntil   DateTime?   // un seul traitement à la fois
  lastStepAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  candidates    SnipeCandidate[]

  @@index([userId, createdAt])
  @@index([status, lastStepAt])
}

model SnipeCandidate {
  id              String               @id @default(cuid())
  runId           String
  run             SnipeRun             @relation(fields: [runId], references: [id], onDelete: Cascade)
  seed            String?              // thème de recherche CJ qui a trouvé le produit (catégorie)
  keyword         String               // recherche eBay utilisée
  supplier        Supplier?
  productId       String?
  variantId       String?
  title           String?
  image           String?
  status          SnipeCandidateStatus @default(PENDING)
  reason          String?              // LOW_MARGIN, NO_DEMAND, NO_PRICE, NO_SUPPLIER, VERO, PRICE_RANGE, ALREADY_LISTED, AUTO_LIST:<code>…
  marketPrice     Float?
  cost            Float?
  profit          Float?
  marginPct       Float?
  unitsSold       Int?
  deliveryDaysMax Int?
  details         Json?                // analyse complète : marché eBay (prix, ventes/mois, concurrents), prix fournisseur, frais eBay…
  listingId       String?
  analyzedAt      DateTime?            // date des données eBay (au-delà de 24 h elles ne sont plus affichées)
  createdAt       DateTime             @default(now())

  @@index([runId, status])
}

/* ---------- Recherche marché : espion de concurrents, Title Builder, meilleures ventes ---------- */

/** Résultats d'analyse gardés quelques heures (limite les appels à eBay). */
model ResearchCache {
  key       String   @id   // ex. seller:EBAY_US:nom:mot-clé, title:EBAY_US:mot-clé
  data      Json
  createdAt DateTime @default(now())
}

/** Vendeurs suivis par un client. */
model SavedSeller {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username    String
  marketplace String
  createdAt   DateTime @default(now())

  @@unique([userId, username, marketplace])
}

/** Meilleures ventes par niche et par pays, relevées chaque jour. */
model TrendItem {
  id           String   @id @default(cuid())
  marketplace  String
  niche        String
  categoryId   String
  categoryName String?
  itemId       String
  title        String
  image        String?
  url          String?
  price        Float
  currency     String
  sold         Int      // ventes cumulées (estimation eBay)
  soldPrev     Int?     // au relevé précédent : sold − soldPrev = ventes du jour
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([marketplace, itemId])
  @@index([marketplace, niche])
}

/* ---------- Retours et annulations (API Post-Order d'eBay) ---------- */

enum AfterSaleType {
  RETURN
  CANCEL
}

model AfterSale {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ebayAccountId String?
  marketplace   String        @default("EBAY_US")
  type          AfterSaleType
  ebayId        String        // returnId ou cancelId
  ebayOrderId   String
  orderId       String?       // notre commande (si elle vient de l'outil)
  state         String        // état eBay (RETURN_REQUESTED, CANCEL_REQUESTED…)
  open          Boolean       @default(true)
  reason        String?
  buyerComment  String?
  amount        Float?
  currency      String?
  itemTitle     String?
  requestedAt   DateTime?
  action        String?       // ce que le vendeur a fait depuis l'outil (APPROVED, ACCEPTED, SUPPLIER_CANCELLED)
  actionAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([type, ebayId])
  @@index([userId, open])
}

/**
 * Produits du catalogue fournisseur déjà analysés (commun à tout le site), remplis par le scanner de fond
 * et par les recherches Sniper. Le Sniper y pioche d'abord : résultats immédiats au lieu d'une analyse en direct.
 */
model ProductInsight {
  id              String   @id @default(cuid())
  marketplace     String
  supplier        Supplier
  productId       String
  variantId       String?
  seed            String?  // thème de recherche CJ (catégorie) ; null pour les analyses plus anciennes
  keyword         String
  title           String?
  image           String?
  reason          String?  // rejet définitif pour tous (pas de stock local, pas de prix, pas de demande, marque protégée), sinon null
  marketPrice     Float?
  cost            Float?   // coût rendu (produit + livraison)
  profit          Float?
  marginPct       Float?
  unitsSold       Int      @default(0)
  deliveryDaysMax Int?
  details         Json?
  analyzedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  @@unique([marketplace, supplier, productId])
  @@index([marketplace, reason, marginPct])
  @@index([analyzedAt])
}

/** Progression du scanner de fond dans le catalogue (une ligne par pays). */
model ScanCursor {
  marketplace String   @id
  seed        Int      @default(0)
  round       Int      @default(1)
  updatedAt   DateTime @updatedAt
}

/// Petit état partagé entre les serveurs (ex. quota eBay atteint jusqu'à telle heure, cache de recherches).
model AppState {
  key       String    @id
  value     Json
  expiresAt DateTime?
  updatedAt DateTime  @updatedAt

  @@index([expiresAt])
}

/// Connexion de l'extension navigateur : jeton aléatoire (seule son empreinte SHA-256 est gardée), révocable.
model ExtensionToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  label      String?   // navigateur (ex. « Chrome · macOS »)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

/// Liste d'idées : produits fournisseur mis de côté depuis l'extension.
model SavedProduct {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplier  Supplier
  productId String
  title     String?
  image     String?
  /// Instantané au moment de la sauvegarde (depuis le Sniper ou les produits gagnants) : vide si gardé depuis l'extension.
  keyword   String?
  marketId  String?
  price     Float?
  cost      Float?
  profit    Float?
  marginPct Float?
  createdAt DateTime @default(now())

  @@unique([userId, supplier, productId])
  @@index([userId, createdAt])
}

/// Rédactions IA utilisées par mois (quota de la formule).
model AiUsage {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  month  String // « 2026-10 » (UTC)
  count  Int    @default(0)

  @@id([userId, month])
}

/// Annonce eBay active créée en dehors de Sellvela (détectée sur le compte du vendeur).
model ExternalListing {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  ebayAccountId String
  ebayAccount   EbayAccount @relation(fields: [ebayAccountId], references: [id], onDelete: Cascade)
  marketplace   String
  itemId        String
  title         String
  price         Float
  currency      String
  quantity      Int
  sku           String?
  image         String?
  hasVariations Boolean     @default(false)
  startedAt     DateTime?
  syncedAt      DateTime
  listingId     String?     // annonce gérée par Sellvela après liaison à un produit fournisseur

  @@unique([ebayAccountId, itemId])
  @@index([userId])
}

/// Une variante d'une annonce à variantes (une taille, une couleur…) : sa propre offre eBay, son stock et son prix.
model ListingVariant {
  id                String    @id @default(cuid())
  listingId         String
  listing           Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  sku               String    @unique
  supplierVariantId String
  label             String
  options           Json      // ex. { "Size": "L", "Quantity": "1PCS" }
  image             String?
  price             Float
  quantity          Int       @default(3)
  supplierCost      Float
  lastMarginPct     Float?
  status            String    @default("ACTIVE") // ACTIVE | PAUSED
  pauseReason       String?
  ebayOfferId       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([listingId])
}

/// Question d'un acheteur sur eBay (« où est ma commande ? ») ; l'IA prépare une réponse, le vendeur l'envoie d'un clic.
model BuyerMessage {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ebayAccountId  String
  marketplace    String    @default("EBAY_US")
  messageId      String
  itemId         String?
  itemTitle      String?
  buyer          String
  subject        String?
  body           String
  questionType   String?
  receivedAt     DateTime  @default(now())
  status         String    @default("NEW") // NEW | REPLIED | DISMISSED
  orderId        String?   // commande Sellvela de cet acheteur (contexte de la réponse)
  draft          String?
  draftAt        DateTime?
  draftError     String?
  repliedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([ebayAccountId, messageId])
  @@index([userId, status])
}

/// Notifications du navigateur (Web Push) : un abonnement par appareil.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}
