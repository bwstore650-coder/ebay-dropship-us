// Schéma de la base de données (Postgres) — V1
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  NONE
  STARTER
  PRO
  BUSINESS
  AGENCY
}

enum Supplier {
  ALIEXPRESS
  CJ
}

enum ListingStatus {
  DRAFT
  ACTIVE
  PAUSED     // retirée automatiquement (rupture, marge sous le seuil)
  ENDED
}

enum OrderStatus {
  PENDING          // vente eBay reçue, pas encore commandée
  ORDERING         // commande fournisseur en cours (verrou contre les doublons)
  ORDERED          // commandée et payée chez le fournisseur
  SHIPPED          // suivi reçu et renvoyé à eBay
  NEEDS_REVIEW     // à vérifier par le vendeur (perte, rupture, article inconnu…)
  FAILED           // le fournisseur a refusé (solde insuffisant, adresse…)
  CANCELLED        // annulée sur eBay, ou traitée à la main par le vendeur
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  createdAt          DateTime  @default(now())
  locale             String    @default("en") // langue des emails
  termsAcceptedAt    DateTime?
  passwordChangedAt  DateTime?  // les sessions ouvertes avant cette date sont refusées
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?  // blocage temporaire après trop d'essais de mot de passe
  lastAttentionEmailAt DateTime? // dernier email « commandes à vérifier »
  resetTokens        PasswordResetToken[]

  plan               Plan      @default(NONE)
  stripeCustomerId   String?   @unique
  stripeSubscriptionId String? @unique
  billingInterval    String?   // "month" | "year" (depuis Stripe)
  trialEndsAt        DateTime?
  currentPeriodEnd   DateTime?

  minMarginPct       Float     @default(30)    // seuil de marge (%)
  defaultMarketplace String    @default("EBAY_US") // EBAY_US, EBAY_CA, EBAY_GB, EBAY_AU
  ebayAccountOpenedAt DateTime?                // pour les limites anti-ban
  autoOrder          Boolean   @default(true)    // commander automatiquement chez le fournisseur à chaque vente

  // Personne responsable dans l'UE (règlement GPSR) : obligatoire pour vendre sur eBay DE, FR, IT, ES, IE
  euRpCompany        String?
  euRpAddress        String?
  euRpCity           String?
  euRpPostalCode     String?
  euRpCountry        String?   // code pays ISO (DE, FR…)
  euRpEmail          String?

  // Affiliation
  referralCode       String?   @unique
  referredById       String?
  referredBy         User?     @relation("Referrals", fields: [referredById], references: [id])
  referrals          User[]    @relation("Referrals")
  commissionsEarned  Commission[] @relation("AffiliateCommissions")
  commissionsFrom    Commission[] @relation("ReferredCommissions")

  ebayAccounts       EbayAccount[]
  supplierAccounts   SupplierAccount[]
  listings           Listing[]
  orders             Order[]
  review             Review?
  snipeRuns          SnipeRun[]
}

model EbayAccount {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label              String?  // nom donné par le client (formule Agence : un compte par boutique gérée)
  ebayUserId         String?
  accessToken        String   // chiffré au repos (voir lib/crypto.ts)
  accessTokenExpires DateTime
  refreshToken       String   // chiffré au repos
  refreshTokenExpires DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  listings           Listing[]
  orders             Order[]
  marketSetups       EbayMarketSetup[]

  @@index([userId])
}

/// Réglages eBay obligatoires avant de publier dans un pays : politiques (livraison, paiement, retours) + lieu d'expédition.
model EbayMarketSetup {
  id                  String      @id @default(cuid())
  ebayAccountId       String
  ebayAccount         EbayAccount @relation(fields: [ebayAccountId], references: [id], onDelete: Cascade)
  marketplaceId       String
  fulfillmentPolicyId String
  paymentPolicyId     String
  returnPolicyId      String
  merchantLocationKey String
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@unique([ebayAccountId, marketplaceId])
}

model SupplierAccount {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplier     Supplier
  accessToken  String   // chiffré au repos
  refreshToken String?
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, supplier])
}

model Listing {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           ListingStatus @default(DRAFT)
  ebayAccountId    String?
  ebayAccount      EbayAccount?  @relation(fields: [ebayAccountId], references: [id], onDelete: SetNull)
  marketplace      String        @default("EBAY_US")
  currency         String        @default("USD")
  sku              String        @unique
  ebayOfferId      String?
  ebayListingId    String?
  title            String
  price            Float         // dans la devise de la marketplace
  supplier         Supplier
  supplierProductId String
  supplierVariantId String?
  supplierCost     Float         // coût produit + livraison (devise de la marketplace) au dernier contrôle
  lastCheckedAt    DateTime?
  lastMarginPct    Float?
  quantity         Int           @default(3)   // quantité affichée sur eBay quand l'annonce est active
  pauseReason      String?       // OUT_OF_STOCK, MARGIN, SLOW, SUPPLIER_GONE : pourquoi l'annonce est en pause
  pauseDetail      String?       // ex. prix minimum conseillé pour retrouver la marge
  categoryId       String?
  errorMessage     String?       // dernier refus d'eBay, pour l'afficher au client
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  orders           Order[]

  @@index([ebayAccountId, publishedAt])
  @@index([userId, createdAt])
}

model Order {
  id                 String      @id @default(cuid())
  userId             String
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  ebayAccountId      String?
  ebayAccount        EbayAccount? @relation(fields: [ebayAccountId], references: [id], onDelete: SetNull)
  listingId          String?     // première annonce de la commande
  listing            Listing?    @relation(fields: [listingId], references: [id])
  ebayOrderId        String      @unique
  ebayCreatedAt      DateTime?
  marketplace        String      @default("EBAY_US")
  currency           String      @default("USD")
  status             OrderStatus @default(PENDING)
  lines              Json        @default("[]") // [{ lineItemId, sku, quantity, listingId, vid, title }]
  saleTotal          Float
  supplierOrderId    String?
  supplierCost       Float?      // coût fournisseur (devise de la commande)
  fees               Float?      // frais eBay estimés
  profit             Float?
  trackingNumber     String?
  carrier            String?
  errorCode          String?     // raison lisible, traduite à l'écran (LOSS, OUT_OF_STOCK…)
  errorMessage       String?     // détail (message du fournisseur ou d'eBay)
  attempts           Int         @default(0)
  orderedAt          DateTime?
  shippedAt          DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([userId, status])
  @@index([status, updatedAt])
}

/// Emails récoltés par les outils gratuits (calculateur, etc.)
model Lead {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   // ex. "profit-calculator"
  refCode   String?  // code affilié présent au moment de l'inscription
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum CommissionStatus {
  PENDING   // en période de garantie (remboursements possibles)
  PAYABLE   // à verser à l'affilié
  PAID
  VOID      // annulée (remboursement, fraude)
}

/// Commission d'affiliation : 30 % de chaque facture payée par un client parrainé, à vie.
model Commission {
  id              String           @id @default(cuid())
  affiliateId     String
  affiliate       User             @relation("AffiliateCommissions", fields: [affiliateId], references: [id], onDelete: Cascade)
  referredUserId  String
  referredUser    User             @relation("ReferredCommissions", fields: [referredUserId], references: [id], onDelete: Cascade)
  stripeInvoiceId String           @unique   // une commission par facture (idempotent)
  amountCents     Int
  currency        String           @default("usd")
  status          CommissionStatus @default(PENDING)
  availableAt     DateTime                    // fin de la période de garantie
  paidAt          DateTime?
  createdAt       DateTime         @default(now())

  @@index([affiliateId, status])
}

// Avis clients : écrits par de vrais utilisateurs connectés, publiés seulement après validation dans /admin/reviews.
enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id         String       @id @default(cuid())
  userId     String       @unique // un avis par compte
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Int          // 1 à 5
  text       String
  authorName String       // nom affiché (choisi par le client)
  authorInfo String?      // ex. « Vendeur eBay, Texas »
  locale     String
  consent    Boolean      // accord pour publication sur le site
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  approvedAt DateTime?

  @@index([status, approvedAt])
}

/// Lien « mot de passe oublié » : seule l'empreinte SHA-256 du jeton est enregistrée ; valable 1 heure, une seule fois.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

/* ---------- Sniper : recherche automatique de produits rentables ---------- */

enum SnipeMode {
  CATALOG   // parcourt le catalogue du fournisseur (entrepôt du pays) et vérifie chaque produit sur eBay
  KEYWORDS  // teste une liste de mots-clés fournie par le vendeur
}

enum SnipeStatus {
  RUNNING
  DONE
  STOPPED
  FAILED
}

enum SnipeCandidateStatus {
  PENDING     // pas encore analysé
  PROFITABLE  // rentable, prêt à mettre en vente
  REJECTED    // écarté (voir reason)
  LISTED      // mis en vente automatiquement
  ERROR       // analyse impossible (panne passagère)
}

model SnipeRun {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode          SnipeMode
  marketplace   String
  target        Int         // nombre de produits rentables à trouver
  minMarginPct  Float
  priceMin      Float?
  priceMax      Float?
  autoList      Boolean     @default(false)
  ebayAccountId String?
  seeds         Json        // mots-clés (thèmes du catalogue, ou liste à tester)
  cursor        Json?       // progression dans le catalogue
  status        SnipeStatus @default(RUNNING)
  scanned       Int         @default(0)
  found         Int         @default(0)
  listed        Int         @default(0)
  error         String?
  lockedUntil   DateTime?   // un seul traitement à la fois
  lastStepAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  candidates    SnipeCandidate[]

  @@index([userId, createdAt])
  @@index([status, lastStepAt])
}

model SnipeCandidate {
  id              String               @id @default(cuid())
  runId           String
  run             SnipeRun             @relation(fields: [runId], references: [id], onDelete: Cascade)
  keyword         String               // recherche eBay utilisée
  supplier        Supplier?
  productId       String?
  variantId       String?
  title           String?
  image           String?
  status          SnipeCandidateStatus @default(PENDING)
  reason          String?              // LOW_MARGIN, NO_DEMAND, NO_PRICE, NO_SUPPLIER, VERO, PRICE_RANGE, ALREADY_LISTED, AUTO_LIST:<code>…
  marketPrice     Float?
  cost            Float?
  profit          Float?
  marginPct       Float?
  unitsSold       Int?
  deliveryDaysMax Int?
  listingId       String?
  createdAt       DateTime             @default(now())

  @@index([runId, status])
}
