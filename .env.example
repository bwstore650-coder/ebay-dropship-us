# Copie ce fichier en .env et remplis les valeurs.
APP_URL=http://localhost:3000

# Postgres (ex. base gratuite Neon ou Supabase)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Ton email (et ceux de ton équipe) : accès à l'espace admin /admin
ADMIN_EMAILS=labossierejames3452@gmail.com

# Générer avec : openssl rand -hex 32
SESSION_SECRET=
ENCRYPTION_KEY=

# eBay Developer Program — developer.ebay.com (commencer en sandbox)
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# RuName de l'app eBay ; son « Auth accepted URL » doit pointer vers APP_URL/api/ebay/callback
EBAY_RUNAME=

# AliExpress Open Platform (accès Dropshipping à demander)
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=

# Stripe (mode test d'abord)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Un prix mensuel et un prix annuel (−25 %) par formule
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=
STRIPE_PRICE_AGENCY_MONTHLY=
STRIPE_PRICE_AGENCY_YEARLY=

# Marque (nom provisoire)
NEXT_PUBLIC_BRAND_NAME=ProfitLister
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
