{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Sellvela",
  "description": "__MSG_extDescription__",
  "version": "1.0.0",
  "default_locale": "en",
  "homepage_url": "https://sellvela.vercel.app",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sellvela",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "contextMenus"
  ],
  "host_permissions": [
    "https://sellvela.vercel.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://cjdropshipping.com/*",
        "https://www.cjdropshipping.com/*"
      ],
      "js": [
        "src/i18n.js",
        "src/content-cj.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://sellvela.vercel.app/extension/connect*"
      ],
      "js": [
        "src/content-connect.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.ebay.com/itm/*",
        "https://www.ebay.ca/itm/*",
        "https://www.ebay.co.uk/itm/*",
        "https://www.ebay.com.au/itm/*",
        "https://www.ebay.de/itm/*",
        "https://www.ebay.fr/itm/*",
        "https://www.ebay.it/itm/*",
        "https://www.ebay.es/itm/*",
        "https://www.ebay.ie/itm/*"
      ],
      "js": [
        "src/i18n.js",
        "src/content-ebay.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/lib.js"
      ],
      "matches": [
        "https://cjdropshipping.com/*",
        "https://www.cjdropshipping.com/*"
      ]
    },
    {
      "resources": [
        "src/lib.js"
      ],
      "matches": [
        "https://www.ebay.com/*",
        "https://www.ebay.ca/*",
        "https://www.ebay.co.uk/*",
        "https://www.ebay.com.au/*",
        "https://www.ebay.de/*",
        "https://www.ebay.fr/*",
        "https://www.ebay.it/*",
        "https://www.ebay.es/*",
        "https://www.ebay.ie/*"
      ]
    }
  ]
}