{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Sellvela",
  "description": "__MSG_extDescription__",
  "version": "1.0.0",
  "default_locale": "en",
  "homepage_url": "https://sellvela.vercel.app",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sellvela",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "contextMenus"
  ],
  "host_permissions": [
    "https://sellvela.vercel.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://cjdropshipping.com/*",
        "https://www.cjdropshipping.com/*"
      ],
      "js": [
        "src/i18n.js",
        "src/content-cj.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://sellvela.vercel.app/extension/connect*"
      ],
      "js": [
        "src/content-connect.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/lib.js"
      ],
      "matches": [
        "https://cjdropshipping.com/*",
        "https://www.cjdropshipping.com/*"
      ]
    }
  ]
}