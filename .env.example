# Copie ce fichier en .env et remplis les valeurs.
APP_URL=http://localhost:3000

# Postgres (ex. base gratuite Neon ou Supabase)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Ton email (et ceux de ton équipe) : accès à l'espace admin /admin
ADMIN_EMAILS=labossierejames3452@gmail.com

# Générer avec : openssl rand -hex 32
SESSION_SECRET=
ENCRYPTION_KEY=

# eBay Developer Program — developer.ebay.com (commencer en sandbox)
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# RuName de l'app eBay ; son « Auth accepted URL » doit pointer vers APP_URL/api/ebay/callback
EBAY_RUNAME=

# AliExpress Open Platform (app avec l'accès Dropshipping) : Callback URL à déclarer = <APP_URL>/api/suppliers/aliexpress/callback
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=

# Stripe (mode test d'abord)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Un prix mensuel et un prix annuel (−25 %) par formule
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=
STRIPE_PRICE_AGENCY_MONTHLY=
STRIPE_PRICE_AGENCY_YEARLY=

# Marque (nom provisoire)
NEXT_PUBLIC_BRAND_NAME=Sellvela
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# Rédaction des annonces par IA (API Claude d'Anthropic : https://console.anthropic.com)
# Sans clé, l'outil reprend le texte du fournisseur (à relire avant de publier).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Tâche planifiée des commandes automatiques (toutes les 15 min, voir vercel.json) : longue chaîne aléatoire
CRON_SECRET=

# Emails (mot de passe oublié, bienvenue, paiement refusé, commandes à vérifier) : https://resend.com
# Sans clé, les emails sont seulement écrits dans les journaux du serveur.
RESEND_API_KEY=
EMAIL_FROM="Sellvela <noreply@votre-domaine.com>"
